#!/bin/sh
# Stand-in for the Claude Code CLI: records what it was given, then streams a reply.
here="$(dirname "$0")"
if [ "$1" = "--version" ]; then echo "9.9.9 (Fake Claude)"; exit 0; fi
printf '%s\n' "$*" > "$here/last_args.txt"
cat > "$here/last_prompt.txt"
emit() { printf '%s\n' "$1"; sleep 0.12; }
if grep -q ASKME "$here/last_prompt.txt"; then
  emit '{"type":"system","subtype":"init","session_id":"11111111-2222-3333-4444-555555555555"}'
  emit '{"type":"assistant","message":{"content":[{"type":"text","text":"Which part?\n\n```choices\n{\"question\": \"Which section?\", \"multi\": false, \"options\": [\"Verse\", \"Chorus\", \"Bridge\"]}\n```"}]}}'
  emit '{"type":"result","subtype":"success","is_error":false,"result":"x","session_id":"11111111-2222-3333-4444-555555555555"}'
  exit 0
fi
if grep -q ASKMULTI "$here/last_prompt.txt"; then
  emit '{"type":"system","subtype":"init","session_id":"11111111-2222-3333-4444-555555555555"}'
  emit '{"type":"assistant","message":{"content":[{"type":"text","text":"```choices\n{\"question\": \"\u3069\u308c\u3092\u8abf\u3079\u307e\u3059\u304b\uff1f\", \"multi\": true, \"options\": [\"EQ\", \"Comp\", \"Reverb\"]}\n```"}]}}'
  emit '{"type":"result","subtype":"success","is_error":false,"result":"x","session_id":"11111111-2222-3333-4444-555555555555"}'
  exit 0
fi
emit '{"type":"active_goal","session_id":"s","uuid":"u","value":null}'
emit '{"type":"system","subtype":"init","session_id":"11111111-2222-3333-4444-555555555555","cwd":"/x"}'
emit '{"type":"stream_event","event":{"type":"message_start","message":{}}}'
emit '{"type":"stream_event","event":{"type":"content_block_start","index":0,"content_block":{"type":"text","text":""}}}'
emit '{"type":"stream_event","event":{"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"\u3053\u306e\u30b3\u30fc\u30c9\u306f "}}}'
emit '{"type":"stream_event","event":{"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"Cm7 \u2192 F7 \ud83c\udfb9 \"quoted\"\nline2"}}}'
emit '{"type":"assistant","message":{"content":[{"type":"text","text":"\u3053\u306e\u30b3\u30fc\u30c9\u306f Cm7 \u2192 F7 \ud83c\udfb9 \"quoted\"\nline2"}]},"session_id":"11111111-2222-3333-4444-555555555555"}'
emit '{"type":"result","subtype":"success","is_error":false,"result":"final","session_id":"11111111-2222-3333-4444-555555555555","num_turns":1}'
